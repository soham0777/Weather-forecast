# Copy to .env and adjust if needed. Every value here is a safe local default.
# Never commit your .env file.

DATABASE_URL=sqlite:///./bank.db
# Comma-separated list of allowed browser origins (CORS). Never use "*".
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173
API_HOST=127.0.0.1
API_PORT=8000
ENVIRONMENT=development

# DEMO AUTHENTICATION: key used to sign the simulator's demo JWTs (not a real secret).
DEMO_JWT_SECRET=demo-only-signing-key-not-a-real-secret
TOKEN_TTL_SECONDS=3600

# In-memory rate limiter: requests allowed per client per window.
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# Simulated NEFT batch settlement delay (seconds).
NEFT_SETTLEMENT_SECONDS=20

# Simulator helper endpoints (/api/v1/demo/...). Set to false to hide them.
ENABLE_DEMO_ENDPOINTS=true
LOG_LEVEL=INFO
