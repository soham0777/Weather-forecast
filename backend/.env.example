# ---------------------------------------------------------------
# CIMS backend environment variables (copy to backend/.env for local
# development; set them in the hosting dashboard for production).
# Never commit the real .env file.
# ---------------------------------------------------------------

# MySQL connection (production: the managed database URL, with SSL)
DB_URL=jdbc:mysql://localhost:3306/cims?serverTimezone=UTC&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=cims_app
DB_PASSWORD=change-me

# JWT signing secret: at least 32 random characters.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=
# Token lifetime in minutes (default 480 = 8 hours)
JWT_EXPIRATION_MINUTES=480

# Where uploaded resumes are stored (use a persistent disk/volume in production)
FILE_STORAGE_PATH=./uploads

# Browser origins allowed to call the API (comma-separated, no trailing slash)
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Public URL of the frontend (used in e-mail verification links)
FRONTEND_URL=http://localhost:5173

# College time zone for deadlines and interview rules
APP_TIMEZONE=Asia/Kolkata

# E-mail (SMTP). With MAIL_ENABLED=false, verification links are written to the log.
MAIL_ENABLED=false
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@your-college.edu

# Optional, first production start only: creates the initial administrator when no
# admin exists. Remove both variables after the first successful start.
# BOOTSTRAP_ADMIN_EMAIL=admin@your-college.edu
# BOOTSTRAP_ADMIN_PASSWORD=

# Optional: HTTP port (hosting platforms usually set PORT automatically)
# PORT=8080
